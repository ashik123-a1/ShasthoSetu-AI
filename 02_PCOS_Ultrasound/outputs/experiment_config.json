{
  "experiment_name": "pcos_ultrasound_cv_baseline",
  "dataset": "Ovarian Ultrasound Dataset (Borna et al. 2025)",
  "random_seed": 42,
  "input_size": [
    224,
    224
  ],
  "batch_size": 16,
  "num_workers": 2,
  "learning_rate": 0.0001,
  "weight_decay": 0.0001,
  "max_epochs": 15,
  "early_stopping_patience": 4,
  "metric_for_best_model": "val_macro_f1",
  "models": [
    "resnet18",
    "mobilenet_v3_small"
  ],
  "classes": [
    "Dominant_Follicle",
    "Normal",
    "PCO"
  ],
  "train_ratio": 0.7,
  "val_ratio": 0.15,
  "test_ratio": 0.15,
  "deduplication": {
    "enabled": true,
    "removed_duplicates": [
      "Dominant_Follicle_128.jpg",
      "Dominant_Follicle_86.jpg"
    ]
  }
}