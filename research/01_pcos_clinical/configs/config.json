{
  "experiment_name": "pcos_clinical_tabular_baseline",
  "dataset": "PCOS Clinical (Mendeley Data tw34c7hv7z/1)",
  "random_seed": 42,
  "test_size": 0.2,
  "cv_folds": 5,
  "target_column": "target_pcos",
  "imputation_strategy": "median",
  "scaling": "standard",
  "models": {
    "logistic_regression": {
      "C": 1.0,
      "max_iter": 1000,
      "solver": "liblinear"
    },
    "random_forest": {
      "n_estimators": 100,
      "max_depth": 5,
      "random_state": 42
    },
    "xgboost": {
      "n_estimators": 100,
      "max_depth": 3,
      "learning_rate": 0.05,
      "random_state": 42,
      "eval_metric": "logloss"
    }
  }
}
