03_Measles_Viral_Rash/data/processed/*
04_Prescription_OCR/data/processed/*
05_Bangla_Voice_AI/data/processed/*

# Keep data dirs tracked
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep

# Large model checkpoints
*.pth
*.pt
*.bin
*.onnx
*.safetensors
*.joblib

