05_Bangla_Voice_AI/data/processed/*
06_DermoPed_Pediatric_Skin/data/raw/*
06_DermoPed_Pediatric_Skin/data/processed/*

# Preserve directory placeholders
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep

