# ==============================================================================
# ShasthoSetu AI — Git Ignore Policy
# Heavy clinical datasets (~9 GB) & checkpoints are hosted on Hugging Face:
#   https://huggingface.co/datasets/ashik1236/shasthosetu-clinical-datasets
# Ready-to-test sample QA pack lives inside testingmainapps/ (tracked in Git).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Virtual Environments, Caches & Test Artifacts
# ------------------------------------------------------------------------------
_shared/venv/
.venv/
venv/
**/venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# ------------------------------------------------------------------------------
# 2. Node.js, Frontend Builds & Playwright Scratch Outputs
# ------------------------------------------------------------------------------
node_modules/
apps/web/dist/
apps/web/.vite/
apps/web/test-results/
apps/web/playwright-report/

# ------------------------------------------------------------------------------
# 3. Local Runtime Databases, RAG Binary Indices, OCR Vaults & Secrets
# ------------------------------------------------------------------------------
services/api/data/
services/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.env
.env.*
!.env.example
!services/api/.env.cpanel.example
LIVE_ONLINE_LINK.txt

# ------------------------------------------------------------------------------
# 4. Heavy Clinical Datasets (Hosted on Hugging Face Hub)
# ------------------------------------------------------------------------------
01_PCOS_Clinical/data/raw/*
01_PCOS_Clinical/data/processed/*
02_PCOS_Ultrasound/data/raw/*
02_PCOS_Ultrasound/data/processed/*
03_Measles_Viral_Rash/data/raw/*
