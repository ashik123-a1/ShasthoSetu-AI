# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Windows batch & PowerShell scripts must use CRLF on checkout
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Explicitly mark binary assets so Git never corrupts line endings
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.wav binary
*.mp3 binary
