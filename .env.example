# ShasthoSetu AI — Environment Configuration Example (FULLSTACK-01)
# Copy this file to .env if overriding defaults; never commit real secrets.

# Runtime environment: development | production
SHASTHOSETU_ENV=development

# SQLite database file path (WAL + foreign_keys=ON enabled automatically)
SHASTHOSETU_DB_PATH=services/api/data/shasthosetu.db

# Show quick-fill synthetic demo account helpers on /login (true | false)
SHASTHOSETU_SHOW_DEMO_CREDENTIALS=true

# Explicit comma-separated CORS origins (never use wildcard '*' with credentials)
SHASTHOSETU_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
