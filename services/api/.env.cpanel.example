# ==============================================================================
# ShasthoSetu AI — Environment Configuration for cPanel Shared Hosting ($2-$5/mo)
# ==============================================================================

SHASTHOSETU_ENV=production
CPANEL_MODE=true

# AI INFERENCE SWITCH
# Set to false to disable heavy PyTorch, Whisper, and Ollama requirements
AI_INFERENCE_ENABLED=false
RAG_INFERENCE_ENABLED=true
VOICE_AI_ENABLED=false
OCR_ENABLED=false

# SQLite Database Location in cPanel home directory
SHASTHOSETU_DB_PATH=/home/username/shasthosetu/services/api/data/shasthosetu.db
RAG_INDEX_DIR=/home/username/shasthosetu/services/api/data/rag_index
RAG_CORPUS_DIR=/home/username/shasthosetu/services/api/data/rag_corpus

# Security & CORS
SHASTHOSETU_CORS_ORIGINS=https://shasthosetu.ai,https://www.shasthosetu.ai
SHASTHOSETU_SHOW_DEMO_CREDENTIALS=false
